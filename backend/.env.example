FLASK_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-jwt
# SQLite (dev) or MySQL:
# DATABASE_URL=sqlite:///webshell.db
DATABASE_URL=mysql+pymysql://webshell:password@127.0.0.1:3306/webshell?charset=utf8mb4
WEBSHELL_INSTALL_DIR=/opt/webshell_monitor
WEBSHELL_CONFIG_ROOT=/etc/webshell-monitor/sites
WEBSHELL_DRY_RUN=0
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin123
